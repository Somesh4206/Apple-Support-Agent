# --- secrets & environments ---
.env

# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.DS_Store

# --- raw dataset (never commit; download from Kaggle, see data/README.md) ---
data/raw/*.csv
data/raw/*.zip
data/raw/*.parquet

# --- processed outputs (regenerated by scripts/prepare_data.py) ---
data/processed/*
!data/processed/.gitkeep
# small, stable run artifacts referenced by reports — version them
!data/processed/eda_summary.json
!data/processed/pipeline_run.json
!data/processed/charts/

# --- model artifacts (future phases) ---
vector_store/
models/

# --- evaluation outputs ---
evaluation/results/*
!evaluation/results/.gitkeep
# measured Phase 2 metrics are small, stable documents — version them
!evaluation/results/baseline_results.json
!evaluation/results/phase2_summary.json
# measured Phase 3 metrics — same rationale (small, stable, versioned)
!evaluation/results/embedding_results.json
!evaluation/results/phase3_summary.json
# measured Phase 4–7 metrics — same rationale (small, stable, versioned)
!evaluation/results/phase4_summary.json
!evaluation/results/phase5_summary.json
!evaluation/results/phase6_summary.json
!evaluation/results/phase7_summary.json
!evaluation/results/retrieval_results.json
!evaluation/results/escalation_results.json
!evaluation/results/generation_results.json
!evaluation/results/agent_results.json

# --- dashboard (Next.js) ---
dashboard/node_modules/
dashboard/.next/
dashboard/out/
dashboard/build/
dashboard/*.tsbuildinfo
dashboard/next-env.d.ts
dashboard/.env*
dashboard/db/*.db
dashboard/retrieval.log
dashboard/server.log
dashboard/dev*.log

# --- notebooks ---
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# keep the configuration template versioned
!dashboard/.env.example
